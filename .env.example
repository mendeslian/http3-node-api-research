# Database (PostgreSQL)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SCHEMA=dev
DB_USERS_TABLE=user
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# App
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Users
SEED_USERS_COUNT=1000
DEFAULT_LIST_SIZE=100
MAX_LIST_SIZE=5000
DEFAULT_USER_BIO_SIZE=256000000

# Benchmark
DEFAULT_DELAY_MS=0
MAX_DELAY_MS=60000
DEFAULT_COMPUTE_ITERATIONS=50000
MAX_COMPUTE_ITERATIONS=50000000
DEFAULT_STREAM_CHUNKS=10
MAX_STREAM_CHUNKS=10000
DEFAULT_STREAM_CHUNK_SIZE=1024
MAX_STREAM_CHUNK_SIZE=262144
