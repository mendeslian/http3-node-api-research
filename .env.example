# Database (PostgreSQL)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SCHEMA=dev
DB_USERS_TABLE=users
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# App
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Rate limit
# Para benchmarks, aumente este valor no .env local para evitar HTTP 429.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100000

# Users
SEED_USERS_COUNT=1000
DEFAULT_LIST_SIZE=100
MAX_LIST_SIZE=100000
DEFAULT_USER_BIO_SIZE=256000000

# Benchmark
DEFAULT_DELAY_MS=0
MAX_DELAY_MS=60000
DEFAULT_COMPUTE_ITERATIONS=50000
MAX_COMPUTE_ITERATIONS=50000000
DEFAULT_STREAM_CHUNKS=10
MAX_STREAM_CHUNKS=10000
DEFAULT_STREAM_CHUNK_SIZE=1024
MAX_STREAM_CHUNK_SIZE=262144

# k6 benchmark runner
# Opcoes de BENCH_PROFILE:
# health, users-small, users-medium, users-large, stream-medium, compute, delay, all
# Tambem aceita lista com virgula, ex: health,compute,stream-medium
BENCH_PROFILE=users-small
BENCH_PATH=
TARGET_URL=http://localhost:3000
DURATION=30s
RATE_FACTOR=0.25
RATE=
PRE_ALLOCATED_VUS=
MAX_VUS=
SLEEP_MS=0
REQUEST_TIMEOUT=60s
EXPECTED_STATUS=200
MIN_BYTES=
THRESHOLD_P95=
FAILED_RATE=0.01

# Ajustes usados por alguns perfis do k6
USERS_SIZE=100
STREAM_CHUNKS=128
STREAM_CHUNK_SIZE=16384
COMPUTE_ITERATIONS=500000
DELAY_MS=100
