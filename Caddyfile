{
  # Ativa explicitamente o suporte a HTTP/3 (em versões recentes já é padrão)
  servers {
    protocols h1 h2 h3
  }
}

https://localhost:8443 {
  tls internal
  
  # Adiciona header para indicar suporte ao HTTP/3 (Alt-Svc)
  header Alt-Svc "h3=\":8443\"; ma=2592000"
  
  reverse_proxy localhost:3000
}
